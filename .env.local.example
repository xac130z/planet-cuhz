# Supabase Configuration
VITE_SUPABASE_URL=https://wjebryxdefcgsxsqomac.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Canonical Origin for OAuth PKCE Flow
# This prevents cross-subdomain redirects that break PKCE code_verifier in localStorage
# Production: Set to your main domain (e.g., https://planetcuhz.com)
# Development: Set to http://localhost:5173
VITE_CANONICAL_ORIGIN=https://planetcuhz.com
# For local dev override in .env.local:
# VITE_CANONICAL_ORIGIN=http://localhost:5173

# Support Contact
VITE_SUPPORT_EMAIL=streamersupport@planetcuhz.com

# OAuth Provider Display Names
VITE_TWITCH_APP_NAME=Planet CUHZ Protocol
VITE_AUTH_PROVIDER=Twitch
